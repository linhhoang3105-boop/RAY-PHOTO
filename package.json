{
  "name": "buong-toi-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Buong toi — analog photo studio and Linh Linh Pho Cang photobooth",
  "scripts": {
    "build:native": "node scripts/build-native-bridge.mjs",
    "native:sync": "npm run build:native && npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "dev": "node scripts/ray-web-server.mjs dev",
    "build": "node scripts/ray-web-server.mjs build",
    "source:build": "node scripts/assemble-source.mjs",
    "source:check": "node scripts/assemble-source.mjs --check",
    "source:zip": "node scripts/package-source.mjs",
    "dev:local": "node scripts/serve-local.mjs",
    "start": "node scripts/serve-local.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test": "npm run source:check && node --test --test-concurrency=1 test/*.test.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor/haptics": "8.0.0",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.0",
    "@capacitor/status-bar": "8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@napi-rs/canvas": "0.1.100",
    "esbuild": "0.25.12",
    "onnxruntime-web": "1.23.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
