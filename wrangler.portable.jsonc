{
  // Independent deployment template. Create your own D1 database, replace its
  // ID below, then apply the included SQL migrations before publishing.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ray-photo-portable",
  "main": "server/portable-worker.mjs",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./build/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/ray/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ray-photo",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "api-server/drizzle"
    }
  ]
}
